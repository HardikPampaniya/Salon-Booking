# Copy this file to .env in the project root. Put real credentials only in .env.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
# Use a transaction-capable replica set or sharded deployment; keep the real URI only in .env.
MONGODB_URI=
SALON_TIMEZONE=Asia/Kolkata
BOOKING_ENABLED=false
BOOKING_POLICY_VERSION=draft-v1
PRIVACY_POLICY_VERSION=draft-v1
MAX_BOOKING_DAYS_AHEAD=60
PUBLIC_SALON_NAME=The Dream Beauty Unisex Studio
OWNER_EMAIL=
# Use `mock` for local Razorpay Test Mode without delivery; use `resend` with a verified sender for email.
NOTIFICATIONS_MODE=mock
RESEND_API_KEY=
EMAIL_FROM=
# For WhatsApp Cloud API, set NOTIFICATIONS_MODE=whatsapp and fill these on the server only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_CONSENT_VERSION=wa-updates-v1
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
