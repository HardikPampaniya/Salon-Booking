# Copy this file to .env in the project root. Put real credentials only in .env.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
# Use a transaction-capable replica set or sharded deployment; keep the real URI only in .env.
MONGODB_URI=
SALON_TIMEZONE=Asia/Kolkata
BOOKING_ENABLED=false
BOOKING_POLICY_VERSION=draft-v1
PRIVACY_POLICY_VERSION=draft-v1
MAX_BOOKING_DAYS_AHEAD=60
PUBLIC_SALON_NAME=The Dream Beauty Unisex Studio
OWNER_EMAIL=
NOTIFICATIONS_MODE=mock
RESEND_API_KEY=
EMAIL_FROM=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
